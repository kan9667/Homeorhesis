# Copy to a local ignored file only when an approved phase requires it.
# Never commit real values. Phase 0 requires no provider or training credentials.

SEH_MODE=FOUNDATION_ONLY
SEH_ARCHITECTURE_VERSION=3.1
SEH_REMOTE_ENABLED=false
SEH_LOCAL_RUNTIME_ENABLED=false
SEH_STEERING_ENABLED=false
SEH_MODEL_TRAINING_ENABLED=false
SEH_UNSLOTH_BACKEND_ENABLED=false
SEH_AGENT_LIGHTNING_ENABLED=false
SEH_CANDIDATE_EXECUTION_ENABLED=false
SEH_AUTO_PROMOTION_ENABLED=false

# Local roots. Actual absolute paths require review and must not expose arbitrary paths to models.
SEH_DATA_DIR=.seh-data
SEH_ARTIFACT_DIR=.seh-data/artifacts
SEH_CONTROL_DB=.seh-data/control.sqlite
SEH_MODEL_STORE=.seh-models
SEH_STEERING_STORE=.seh-data/steering
SEH_TRAINING_ROOT=.seh-training
SEH_TRAINING_CANDIDATE_ROOT=.seh-training/candidates

# Later phases may reference credentials by environment-variable name.
# Never put values in tracked provider headers, MCP config, prompts, datasets, or logs.
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
