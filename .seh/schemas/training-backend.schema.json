{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seh://schemas/training-backend.schema.json",
  "title": "SEH TrainingBackendRef setup schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "backendId",
    "backendVersion",
    "sourceRevision",
    "environmentDigest",
    "capabilityIds",
    "licenseRecordId",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "backendId": {
      "type": "string",
      "minLength": 1
    },
    "backendVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceRevision": {
      "type": "string",
      "minLength": 1
    },
    "environmentDigest": {
      "type": "string",
      "minLength": 16
    },
    "capabilityIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "licenseRecordId": {
      "type": "string",
      "minLength": 1
    },
    "contentHash": {
      "type": "string",
      "minLength": 16
    },
    "status": {
      "type": "string",
      "minLength": 1
    }
  }
}
